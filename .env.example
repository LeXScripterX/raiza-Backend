# Configuración del servidor
PORT=8080
HOST=0.0.0.0

# Base de datos (MariaDB / MySQL)
DATABASE_URL=mysql://userYuwe:123456@localhost:3306/yuwelongo

# Seguridad y JWT
# OJO: comillas simples obligatorias. Sin ellas dotenvy interpreta `$Yx7uT` como una
# variable y el secreto queda distinto al de Java (26 caracteres en vez de 32).
# Para que los tokens de Java sigan valiendo, debe ser idéntico a SecurityConstants.java.
JWT_SECRET='fQw8vDNz3pL!eR$Yx7uT@9sZqG2nH#jM'
JWT_EXPIRATION_HOURS=1

# Opcional: mantiene las URLs del backend Java (/YuweLongo-Backend/api/...)
# CONTEXT_PATH=/YuweLongo-Backend
